{
  // Blygger v0.1 "Seed" reference client.
  // database_id is a placeholder until first deploy (task 11); local dev and
  // tests use miniflare's local D1 and never contact this ID.
  "name": "blyg",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // Deployment mount for the public surface (decision #14): "" = domain root,
  // otherwise "/path". Wire filenames (blyg.json etc.) are fixed regardless.
  "vars": {
    "MOUNT": "/blyg"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blyg",
      "database_id": "f9fbfd23-c0b8-40bc-b0df-eb80b992b5a4",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "blyg-media"
    }
  ],
  // Named environments are per-domain deploys of the same reference client
  // (docs/deploy-stub-sites-plan.md). Non-inheritable keys (vars, d1_databases,
  // r2_buckets, routes) must be redeclared per environment — wrangler does not
  // merge them from the top level.
  "env": {
    "venkateshrao": {
      "name": "blyg-venkateshrao",
      "vars": {
        "MOUNT": "/blyg"
      },
      "routes": [
        { "pattern": "venkateshrao.com/blyg/*", "zone_name": "venkateshrao.com" },
        { "pattern": "venkateshrao.com/studio/*", "zone_name": "venkateshrao.com" },
        { "pattern": "venkateshrao.com/api/*", "zone_name": "venkateshrao.com" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "blyg-venkateshrao",
          "database_id": "c9342724-d1d9-4337-9737-b3850d27c15e",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "blyg-venkateshrao-media"
        }
      ]
    }
  }
}
