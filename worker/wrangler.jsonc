{
  // Blygger v0.1 "Seed" reference client.
  // database_id is a placeholder until first deploy (task 11); local dev and
  // tests use miniflare's local D1 and never contact this ID.
  "name": "blygg",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blygg",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "blygg-media"
    }
  ]
}
